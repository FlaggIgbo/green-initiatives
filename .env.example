# Environment Variables Example
# Copy this file to .env and fill in the values

# Database
DB_NAME=greenInitiatives
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_key_here

# Server
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# Stripe
STRIPE_DISABLED=true
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook: stripe listen --forward-to localhost:8000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Local dev: Stripe requires HTTPS for return_url. Use ngrok and set:
# STRIPE_RETURN_URL_OVERRIDE=https://your-id.ngrok.io/settings

# Round-up cron (Cloud Scheduler → POST /api/cron/flush-roundups)
ROUNDUP_CRON_SECRET=your-random-secret

# Plaid (Bank Linking & Incremental Transaction Sync)
# TODO: Reuse credentials from your existing Plaid account (sandbox / development / production)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# PLAID_WEBHOOK_URL=https://your-service.run.app/api/plaid/webhook

# Alpaca Trading API (Fractional ESG Investing)
# TODO: Configure Paper Trading keys first, then switch base URL for live trading
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AI / LLM & Embeddings (Project Vetting, Transaction Classification, ESG Screener, RAG)
# TODO: Set provider API key and enable Atlas Vector Search index on MongoDB
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small

# Email (Resend)
EMAIL_OTP_ENABLED=false
RESEND_API_KEY=re_xxxxxxxxx

# Frontend (build-time, for Docker)
# VITE_API_URL=http://localhost:8000
# VITE_CDN_URL=https://storage.googleapis.com/your-bucket
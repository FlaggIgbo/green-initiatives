# Server
PORT=8000
NODE_ENV=development
SESSION_SECRET=change-me-in-production

# MongoDB (required; use local Docker container via `npm run services:up` or production URI)
MONGODB_URI=mongodb://localhost:27017/green-initiatives

# Redis (required for Email OTP cache; use local Docker container via `npm run services:up` or production URL)
REDIS_URL=redis://localhost:6379

# Plaid (Bank Linking & Transaction Sync)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Alpaca Trading API (Fractional ESG Investing)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# WebAuthn / Passkeys (defaults to request host/origin in development)
# RP_ID=localhost
# RP_ORIGIN=http://localhost:8000

# SMTP (Email OTP fallback when passkey verification fails; logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Green Initiatives <no-reply@green-initiatives.local>

#!/bin/sh
set -e

current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  echo "❌ Direct push to '$current_branch' is prohibited. Push to a feature branch instead."
  exit 1
fi

./scripts/pre-push-screenshots.sh "$@"
npm run pre-push

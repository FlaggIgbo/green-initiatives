    "react-router-dom": "^7.11.0",
    "react-toastify": "^11.0.5",
    "recharts": "^2.13.0",
    "resend": "^6.10.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.0",

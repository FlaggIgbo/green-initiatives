{
  "name": "green-initiatives",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Acorns-style ESG micro-investing MERN app: Plaid round-ups invested via Alpaca Trading API",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --bundle --format=esm --outdir=dist --packages=external",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test server/__tests__/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env --import tsx scripts/e2e-playwright-flow.ts",
    "screenshots": "node --env-file-if-exists=.env --import tsx scripts/generate-screenshots.ts",
    "screenshots:check": "./scripts/pre-push-screenshots.sh",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "prepare": "husky",
    "pre-push": "npm run check && npm test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.1.1",
    "nodemailer": "^10.6.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "redis": "^6.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.25.0",
    "husky": "^9.0.10",
    "mongodb-memory-server": "^11.0.1",
    "playwright": "^1.58.2",
    "prettier": "^3.2.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}

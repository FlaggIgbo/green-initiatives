{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:no-watch": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --bundle --format=esm --outdir=dist --packages=external",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check:tracked": "git ls-files | grep -E '\\.(ts|tsx|js|jsx|json|css|md)$' | grep -v 'package-lock.json' | xargs prettier --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tracked": "git ls-files | grep -E '\\.(ts|tsx|js|jsx)$' | grep -v 'coverage/' | xargs eslint --no-warn-ignored",
    "test": "jest",
    "test:unit": "jest",
    "test:unit:client": "jest --selectProjects=client",
    "test:unit:server": "jest --selectProjects=server",
    "test:evals": "jest server/__tests__/ai-evals.test.ts",
    "test:integration": "jest server/__tests__",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:flow": "node --env-file-if-exists=.env --import tsx scripts/e2e-playwright-flow.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "screenshots": "node --env-file-if-exists=.env --import tsx scripts/generate-screenshots.ts",
    "screenshots:check": "./scripts/pre-push-screenshots.sh",
    "coverage": "npm test -- --coverage --watchAll",
    "prepare": "husky",
    "pre-push": "npm run format:check:tracked && npm run lint:tracked && npm run check && npm run test:unit",
    "commitlint": "commitlint --edit",
    "i18n:check": "node scripts/check-unused-translations.mjs",
    "i18n:clean": "node scripts/check-unused-translations.mjs --delete"
  },
  "dependencies": {
    "@google-cloud/logging": "^11.2.1",
